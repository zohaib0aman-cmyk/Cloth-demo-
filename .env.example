# Copy to .env (local) or add in your hosting provider's environment settings.

# PostgreSQL connection string. Use a separate database for each demo deployment.
# On Vercel you can skip this: adding a Postgres database from the Storage tab sets it for you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/demo_store"

# Zyntra Lead System — used on the server only to load a lead's brand when the demo is opened with ?id=ZYN-XX-XX-000000.
# Base URL of the lead system, without a trailing slash and without /api/v1.
LEAD_API_URL=""
# Read-only API key for GET /api/v1/demo/leads/{id}. Never prefix with NEXT_PUBLIC_ and never commit a real value.
LEAD_API_KEY=""

# Optional
# SESSION_SECRET=""
# INSECURE_COOKIES=1
