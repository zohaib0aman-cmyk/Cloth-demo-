{
  "name": "zyntra-demo-store",
  "version": "1.0.0",
  "private": true,
  "description": "Zyntra master demo e-commerce store for clothing brands. Rebrand by editing config/brand.json only.",
  "scripts": {
    "dev": "npm run db:prepare && next dev",
    "build": "npm run db:prepare && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:prepare": "node scripts/db-prepare.mjs",
    "db:reset": "node scripts/db-prepare.mjs --reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.29",
    "pdfkit": "^0.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
